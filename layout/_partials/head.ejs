<%
var separator = theme.title_join_string || theme.tab_title_separator
var title = page.title ? [page.title, config.title].join(separator) : config.title
var keywords = page.keywords || config.keywords
if (keywords instanceof Array) {
  keywords = keywords.join(',')
}
var description = page.description || page.excerpt || page.lead
if (!description) {
  var isSeriesPage = /^series\//.test(String(page.path || page.canonical_path || ''))
  if (!isSeriesPage && page.content) description = page.content
}
description = description || config.description
if (description) {
  description = strip_html(description).replace(/\s+/g, ' ').trim().substring(0, 200).trim()
}
var ogImage = page.og_img || page.index_img
var ogImagePath = ogImage ? String(ogImage).replace(/#.*$/, '') : ogImage
var canonicalPath = String(page.canonical_path || page.path || '').replace(/index\.html$/, '')
var canonicalUrl = full_url_for(canonicalPath)
var ogConfig = Object.assign({
  image: ogImagePath && url_for(ogImagePath),
  description: description,
  url: canonicalUrl
}, theme.open_graph)
var ogHtml = ''
if (theme.open_graph.enable) {
  ogHtml = open_graph(ogConfig)
  if (!ogHtml.includes('property="og:image"')) {
    ogHtml = open_graph(Object.assign({}, ogConfig, { image: url_for('/img/default.png') }))
  }
  ogHtml = ogHtml.replace(/(<meta (?:property="og:image"|name="twitter:image") content="[^"]*)#[^"]*"/g, '$1"')
}
%>

<head>
  <meta charset="UTF-8">


  <link rel="apple-touch-icon" sizes="76x76" href="<%= url_for(theme.apple_touch_icon) %>">
  <link rel="icon" href="<%= url_for(theme.favicon) %>">
  <% if (theme.canonical.enable) { %>
    <link rel="canonical" href="<%= canonicalUrl %>"/>
  <% } %>

  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, shrink-to-fit=no">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <% if (theme.force_https) { %>
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
  <% } %>
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0C1118" media="(prefers-color-scheme: dark)">
  <meta name="author" content="<%= page.author || config.author %>">
  <meta name="keywords" content="<%= keywords %>">
  <% if (theme.open_graph.enable) { %>
    <%- ogHtml %>
  <% } else { %>
    <meta name="description" content="<%= description %>">
  <% } %>
  <% if (is_post()) { %>
    <script type="application/ld+json"><%- JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: page.title,
      datePublished: date_xml(page.date),
      dateModified: date_xml(page.updated || page.date),
      author: { '@type': 'Person', name: page.author || config.author },
      publisher: { '@type': 'Organization', name: config.title },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl }
    }).replace(/</g, '\\u003c') %></script>
  <% } %>
  <% if ((theme.post.meta.views.enable && theme.post.meta.views.source === 'busuanzi')
    || (theme.footer.statistics.enable && theme.footer.statistics.source === 'busuanzi')) { %>
    <meta name="referrer" content="no-referrer-when-downgrade">
  <% } %>
  <% if (theme.custom_head) { %>
    <%- theme.custom_head %>
  <% } %>
  <title><%= title %></title>

  <%- partial('_partials/css.ejs') %>
  <%- export_config() %>
  <%- js_ex(theme.static_prefix.internal_js, 'utils.js') %>
  <%- js_ex(theme.static_prefix.internal_js, 'color-schema.js') %>
  <%- partial('_partials/plugins/analytics.ejs') %>

  <%- inject_point('head') %>
</head>
