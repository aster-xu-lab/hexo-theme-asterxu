// AsterXu 视觉 token：天蓝 + 白

:root
  // 面
  --ax-bg #FFFFFF
  --ax-surface #F8FAFC
  --ax-tint #F0F6FF
  --ax-tint-strong #E6F0FF
  --ax-scrim rgba(12, 17, 24, .42)
  // 字
  --ax-ink #181D26
  --ax-body #333840
  --ax-muted #5A6473
  --ax-quiet #6B778C
  // 线
  --ax-line #E0E2E6
  --ax-line-soft #EDEFF2
  // 主色
  --ax-accent #1B61C9
  --ax-accent-hover #254FAD
  --ax-accent-soft #2D7FF9
  --ax-cyan #18BFFF
  --ax-teal #20D9D2
  --ax-amber #B26A00
  --ax-rose #C2355E
  // 系列色：固定分配，用于标签与圆点
  --ax-c1 #1B61C9
  --ax-c1-bg #E8F1FF
  --ax-c2 #0A6E93
  --ax-c2-bg #E3F6FD
  --ax-c3 #0F7A5A
  --ax-c3-bg #E4F7EF
  --ax-c4 #8A5A00
  --ax-c4-bg #FFF4DE
  --ax-c5 #6B3FD4
  --ax-c5-bg #F0EBFF
  --ax-c6 #B02A55
  --ax-c6-bg #FDE8EF
  // 形状
  --ax-radius-chip 999px
  --ax-radius-card 10px
  --ax-font-mono ui-monospace, SFMono-Regular, Menlo, monospace
  --ax-lh-body 1.72

[data-user-color-scheme="dark"]
  --ax-bg #0C1118
  --ax-surface #121A24
  --ax-tint #152233
  --ax-tint-strong #1B2C42
  --ax-ink #E8EEF6
  --ax-body #C3CDDA
  --ax-muted #93A1B3
  --ax-quiet #6E7E92
  --ax-line #222C38
  --ax-line-soft #1A232D
  --ax-accent #5AA2FF
  --ax-accent-hover #8FC0FF
  --ax-accent-soft #2D7FF9
  --ax-cyan #3FC8FF
  --ax-teal #2FE0D8
  --ax-amber #FFB400
  --ax-rose #FF6B8A
  --ax-c1 #7FB2FF
  --ax-c1-bg #16263D
  --ax-c2 #5FD3F5
  --ax-c2-bg #102A33
  --ax-c3 #5FD6A8
  --ax-c3-bg #102E25
  --ax-c4 #F5BF4A
  --ax-c4-bg #2E2413
  --ax-c5 #B49BFF
  --ax-c5-bg #241D38
  --ax-c6 #FF8DAF
  --ax-c6-bg #331820
