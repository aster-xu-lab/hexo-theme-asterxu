.index-series
  margin-bottom 2.5rem
  padding-bottom .25rem
  border-bottom 1px solid var(--line-color)

.index-series-head
  display flex
  justify-content space-between
  align-items baseline
  margin-bottom .35rem
  color var(--sec-text-color)
  font-size .95rem

  a
    color var(--sec-text-color)

.index-series-label
  margin 1rem 0 .15rem
  color var(--sec-text-color)
  font-size .8rem

.index-series-list
  list-style none
  margin 0
  padding 0

  li
    display flex
    gap .75rem
    align-items baseline
    padding .55rem 0
    border-top 1px solid var(--line-color)
    line-height 1.45

  a
    flex 0 0 auto
    font-weight 600
    color var(--text-color)
    white-space nowrap

  span
    color var(--sec-text-color)
    min-width 0

.index-card
  margin-bottom 2.5rem

.index-img
  img
    display block
    width 100%
    height 10rem
    object-fit cover
    box-shadow 0 5px 11px 0 rgba(0, 0, 0, 0.18), 0 4px 15px 0 rgba(0, 0, 0, 0.15)
    border-radius .25rem
    background-color transparent

.index-info
  display flex
  flex-direction column
  justify-content space-between
  padding-top .5rem
  padding-bottom .5rem

.index-header
  color var(--text-color)
  font-size 1.5rem
  font-weight bold
  line-height 1.4
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  margin-bottom .25rem

  .index-pin
    color var(--text-color)
    font-size 1.5rem
    margin-right .15rem

.index-btm
  color var(--sec-text-color)

  a
    color var(--sec-text-color)

.index-excerpt
  color var(--sec-text-color)
  margin 0.5rem 0
  height calc(1.4rem * 3)
  overflow hidden
  display flex

  & > div
    width 100%
    line-height 1.4rem
    word-break break-word
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp 3

.index-excerpt__noimg
  height auto
  max-height calc(1.4rem * 3)

.index-section-head
  display flex
  justify-content space-between
  align-items baseline
  margin-bottom .75rem
  color var(--sec-text-color)
  font-size .95rem

  a
    color var(--sec-text-color)

.index-featured
  margin-bottom 2.5rem
  padding-bottom .25rem
  border-bottom 1px solid var(--line-color)

.index-featured-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1rem

.index-featured-card
  display block
  padding 1.2rem 1.3rem
  border 1px solid var(--line-color)
  border-radius .4rem
  background var(--board-bg-color)
  transition box-shadow .2s, transform .2s

  &:hover
    transform translateY(-2px)
    box-shadow 0 6px 18px rgba(0, 0, 0, .08)

.index-featured-series
  color var(--sec-text-color)
  font-size .75rem
  letter-spacing .04em

.index-featured-card h2
  margin .4rem 0 .45rem
  color var(--text-color)
  font-size 1.05rem
  line-height 1.45
  font-weight 600

.index-featured-card p
  margin 0
  color var(--sec-text-color)
  font-size .9rem
  line-height 1.55

.index-recent
  margin-bottom 2.5rem

.index-recent-list
  list-style none
  margin 0
  padding 0

  li
    display flex
    justify-content space-between
    align-items baseline
    gap 1rem
    padding .55rem 0
    border-top 1px solid var(--line-color)

  a
    color var(--text-color)
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  time
    flex 0 0 auto
    color var(--sec-text-color)
    font-size .85rem

@media (max-width: 767px)
  .index-featured-grid
    grid-template-columns 1fr

  .index-recent-list li
    flex-direction column
    gap .15rem

  .index-recent-list a
    white-space normal

@media (max-width: 767px)
  .index-series-list li
    flex-direction column
    gap .1rem
    padding .7rem 0

  .index-series-list a
    white-space normal

  .index-info
    padding-top 1.25rem

  .index-header
    font-size 1.25rem
    white-space normal
    overflow hidden
    word-break break-word
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp 2

    .index-pin
      font-size 1.25rem

  .index-excerpt
    height auto
    max-height calc(1.4rem * 3)
    margin 0.25rem 0
