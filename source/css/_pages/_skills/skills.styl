// Skills 页（第 13 页）

.ax-skills
  .ax-mono
    font-family var(--ax-font-mono)
    font-size .9em
    font-variant-numeric tabular-nums

.ax-skills-hero .ax-lead
  margin-bottom 18px

.ax-skills-meta
  max-width 34rem
  margin 0
  color var(--ax-muted)
  font-size var(--ax-fs-small)
  line-height 1.6

  a
    color var(--ax-accent)
    text-decoration underline
    text-decoration-thickness 1px
    text-underline-offset 3px

.ax-skills-intro
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  border 1px solid var(--ax-line)
  border-radius var(--ax-radius-card)
  background var(--ax-surface)
  overflow hidden

  h3
    margin 0 0 8px
    color var(--ax-ink)
    font-size .9375rem
    font-weight 600
    line-height 1.4

  p
    margin 0
    color var(--ax-muted)
    font-size .875rem
    line-height 1.7

.ax-skills-intro__item
  padding 24px

  & + &
    border-left 1px solid var(--ax-line)

.ax-skills-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 24px

.ax-skill-card
  display flex
  flex-direction column
  min-width 0
  padding 24px
  border 1px solid var(--ax-line)
  border-radius var(--ax-radius-card)
  background var(--ax-surface)

.ax-skill-card__top
  display flex
  align-items center
  justify-content space-between
  gap 16px
  margin-bottom 18px

.ax-skill-card__index
  color var(--ax-accent)
  font-family var(--ax-font-mono)
  font-size var(--ax-fs-mono)
  font-weight 500

.ax-license-chip
  display inline-flex
  align-items center
  gap 6px
  padding 3px 10px
  border 1px solid var(--ax-line)
  border-radius var(--ax-radius-chip)
  font-size .75rem
  line-height 1.5
  white-space nowrap

  &::before
    content ""
    width 6px
    height 6px
    flex none
    border-radius 50%
    background currentColor

.ax-license-chip--mit
  border-color var(--ax-accent)
  background var(--ax-tint)
  color var(--ax-accent)
  font-family var(--ax-font-mono)
  font-size var(--ax-fs-mono-sm)

.ax-license-chip--none
  border-style dashed
  background var(--ax-bg)
  color var(--ax-muted)

  &::before
    background transparent
    border 1px solid currentColor

.ax-skill-card__name
  margin 0 0 8px
  color var(--ax-ink)
  font-family var(--ax-font-mono)
  font-size 1.0625rem
  font-weight 600
  letter-spacing -.01em
  line-height 1.4
  overflow-wrap anywhere

.ax-skill-card__summary
  margin 0
  color var(--ax-body)
  font-size .9375rem
  line-height 1.65

.ax-skill-card__facts
  display grid
  gap 12px
  margin 20px 0 24px
  padding 16px 0 0
  border-top 1px solid var(--ax-line-soft)

.ax-skill-card__fact
  display grid
  grid-template-columns 72px minmax(0, 1fr)
  gap 12px
  align-items baseline

  dt
    color var(--ax-muted)
    font-size .75rem
    font-weight 400
    line-height 1.6

  dd
    margin 0
    color var(--ax-body)
    font-size .8125rem
    line-height 1.65

.ax-skill-card__repo
  display flex
  align-items center
  gap 8px
  margin-top auto
  padding-top 16px
  border-top 1px solid var(--ax-line-soft)
  color var(--ax-accent)
  font-family var(--ax-font-mono)
  font-size var(--ax-fs-mono)
  line-height 1.5
  transition color var(--ax-dur-fast) var(--ax-ease)

  .ax-ico
    width 14px
    height 14px
    flex none

.ax-skill-card__repo-label
  flex none
  color var(--ax-muted)
  font-family var(--ax-font-sans)
  font-size .75rem

.ax-skill-card__repo-url
  min-width 0
  overflow-wrap anywhere

.ax-skills-note
  margin 24px 0 0
  padding-top 16px
  border-top 1px solid var(--ax-line-soft)
  color var(--ax-muted)
  font-size .875rem
  line-height 1.7

.ax-skills code
  padding 1px 5px
  background var(--ax-surface)
  color var(--ax-ink)
  font-family var(--ax-font-mono)
  font-size .8125em
  overflow-wrap anywhere

.ax-skills-install
  display grid
  grid-template-columns minmax(0, 1fr) 320px
  gap 64px
  align-items start

.ax-skills-steps
  border-top 1px solid var(--ax-line)

  li
    display grid
    grid-template-columns 48px minmax(0, 1fr)
    gap 16px
    padding 20px 0
    border-bottom 1px solid var(--ax-line-soft)

.ax-skills-steps__num
  color var(--ax-accent)
  font-family var(--ax-font-mono)
  font-size var(--ax-fs-mono)
  line-height 1.6

.ax-skills-steps__body h3
  margin 0 0 6px
  color var(--ax-ink)
  font-size .9375rem
  font-weight 600
  line-height 1.45

.ax-skills-steps__body p
  margin 0
  color var(--ax-muted)
  font-size .875rem
  line-height 1.7

.ax-skills-safety
  padding 20px 24px
  border 1px solid var(--ax-line)
  border-radius var(--ax-radius-card)
  background var(--ax-tint)

.ax-skills-safety__title
  display flex
  align-items center
  gap 8px
  margin 0 0 8px
  color var(--ax-ink)
  font-size .875rem
  font-weight 600
  line-height 1.5

  &::before
    content ""
    width 6px
    height 6px
    flex none
    border-radius 1px
    background var(--ax-accent)

.ax-skills-safety p
  margin 0
  color var(--ax-muted)
  font-size .875rem
  line-height 1.7

.ax-skills-verify
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 48px

.ax-skills-verify__col
  h3
    display flex
    align-items center
    gap 8px
    margin 0
    padding-bottom 12px
    border-bottom 1px solid var(--ax-line)
    color var(--ax-ink)
    font-size .9375rem
    font-weight 600
    line-height 1.5

  ul
    margin 0

  li
    padding 12px 0
    border-bottom 1px solid var(--ax-line-soft)
    color var(--ax-muted)
    font-size .875rem
    line-height 1.7

.ax-skills-verify__mark
  width 6px
  height 6px
  flex none
  border 1px solid var(--ax-muted)
  border-radius 1px

.ax-skills-verify__mark--done
  border-color var(--ax-accent)
  background var(--ax-accent)

@media (hover: hover)
  .ax-skills-meta a:hover
    color var(--ax-accent-hover)

  .ax-skill-card__repo:hover
    color var(--ax-accent-hover)

@media (max-width: 991px)
  .ax-skills-install
    grid-template-columns 1fr
    gap 32px

@media (max-width: 767px)
  .ax-skills-hero .ax-lead
    margin-bottom 16px

  .ax-skills-intro
    grid-template-columns 1fr

  .ax-skills-intro__item
    padding 20px

    & + &
      border-left 0
      border-top 1px solid var(--ax-line)

  .ax-skills-grid
    grid-template-columns 1fr

  .ax-skill-card
    padding 20px

  .ax-skills-safety
    padding 20px

  .ax-skills-verify
    grid-template-columns 1fr
    gap 32px
