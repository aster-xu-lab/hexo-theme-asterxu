#local-search-result
  .search-list-title
    border-left 3px solid var(--ax-accent)

    &:focus-visible
      outline 2px solid var(--ax-accent)
      outline-offset -2px

  .search-list-content
    padding 0 1.25rem

  .search-word
    color var(--ax-accent)

  .local-search-empty
    padding 1rem 1.25rem
    color var(--ax-muted)
    font-size .875rem
